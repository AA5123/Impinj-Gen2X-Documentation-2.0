{
  "title": "Quiet Tags Request",
  "description": "Request payload for quieting specific tags.",
  "type": "object",
  "required": [
    "tagQuieting"
  ],
  "properties": {
    "tagQuieting": {
      "type": "object",
      "description": "Tag quieting configuration. Provide exactly one of basic or advanced.",
      "properties": {
        "basic": {
          "type": "object",
          "description": "Basic tag quieting settings.",
          "required": [
            "action",
            "tagIDs"
          ],
          "properties": {
            "action": {
              "type": "string",
              "const": "quiet",
              "enum": [
                "quiet"
              ],
              "description": "Silence the specified tags."
            },
            "tagIDs": {
              "type": "array",
              "description": "List of hexadecimal EPC strings of tags to quiet.",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]+$"
              }
            }
          },
          "additionalProperties": false
        },
        "advanced": {
          "type": "object",
          "description": "Advanced TagQuieting configuration using Impinj Gen2X proprietary features.",
          "required": [
            "tagQuietMasks",
            "target",
            "stateAwareAction"
          ],
          "properties": {
            "preSelect": {
              "type": "array",
              "description": "Optional array of SELECT operations to position tags into specific session states before applying the state-aware SELECT. Maximum 31 items allowed.",
              "maxItems": 31,
              "items": {
                "type": "object",
                "required": [
                  "target",
                  "action",
                  "mask"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "description": "Session or flag to target.",
                    "enum": [
                      "S0",
                      "S1",
                      "S2",
                      "S3",
                      "SL"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "description": "Action to perform on the target session or flag.",
                    "enum": [
                      "ASSERTSL_NOTHING",
                      "DEASSERTSL_NOTHING",
                      "ASSERTSL_ASSERTSL",
                      "ASSERTSL_DEASSERTSL",
                      "DEASSERTSL_ASSERTSL",
                      "DEASSERTSL_DEASSERTSL",
                      "NEGSL_NOTHING",
                      "NOTHING_ASSERTSL",
                      "NOTHING_DEASSERTSL",
                      "NOTHING_NEGSL",
                      "INVA_NOTHING",
                      "INVB_NOTHING",
                      "INVA_INVB",
                      "INVB_INVA",
                      "INVA_INVA",
                      "INVB_INVB",
                      "NOTHING_INVA",
                      "NOTHING_INVB"
                    ]
                  },
                  "mask": {
                    "type": "object",
                    "description": "Memory mask for tag selection.",
                    "required": [
                      "bank",
                      "pointer",
                      "length",
                      "value"
                    ],
                    "properties": {
                      "bank": {
                        "type": "string",
                        "description": "Memory bank to match against.",
                        "enum": [
                          "EPC",
                          "TID",
                          "USER",
                          "RESERVED"
                        ]
                      },
                      "pointer": {
                        "type": "integer",
                        "description": "Bit offset in memory bank.",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "length": {
                        "type": "integer",
                        "description": "Number of bits to match.",
                        "minimum": 1,
                        "maximum": 255
                      },
                      "value": {
                        "type": "string",
                        "description": "Hex string value to match (even length, valid hex characters).",
                        "pattern": "^[0-9A-Fa-f]+$"
                      }
                    }
                  }
                }
              }
            },
            "tagQuietMasks": {
              "type": "array",
              "description": "Session-state combinations to check in TID memory. Minimum 1, maximum 3 items. No duplicate session prefixes allowed (e.g., S0A and S0B together).",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "S0A",
                  "S0B",
                  "S2A",
                  "S2B",
                  "S3A",
                  "S3B",
                  "SL_ASSERT",
                  "SL_DEASSERT"
                ]
              }
            },
            "target": {
              "type": "string",
              "description": "Which flag to manipulate based on state check.",
              "enum": [
                "SL",
                "S0",
                "S1",
                "S2",
                "S3"
              ]
            },
            "stateAwareAction": {
              "type": "string",
              "description": "Action to perform on target flag when tags match the tagQuietMasks pattern.",
              "enum": [
                "ASSERTSL",
                "DEASSERTSL",
                "ASSERTSL_DEASSERTSL",
                "DEASSERTSL_ASSERTSL",
                "NEGSL",
                "NOT_DEASSERTSL",
                "NOT_ASSERTSL",
                "NOT_NEGSL",
                "INV_A",
                "INV_B",
                "INV_A_NOT_INV_B",
                "INV_B_NOT_INV_A",
                "INV_A2BB2A",
                "NOT_INV_B",
                "NOT_INV_A",
                "NOT_INV_A2BB2A"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
