{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    // `@site/*` MUST BE REPEATED HERE. IT IS NOT REDUNDANT. DO NOT DELETE IT.
    //   @docusaurus/tsconfig — the base this file extends — already declares
    //   "paths": { "@site/*": ["./*"] }, and TypeScript does NOT merge `paths`
    //   across `extends`: a `paths` object in the child REPLACES the parent's
    //   outright. So writing only some OTHER `paths` entry here would silently
    //   delete `@site/*`, and `npm run typecheck` — a blocking CI gate in
    //   validate.yml — would fail with 16 × TS2307 "Cannot find module
    //   '@site/src/analytics/track'" across src/client-modules, src/components,
    //   src/pages and src/theme. This happened, exactly that way, while wiring
    //   shadcn in (`@/*` -> `src/*`, removed 2026-08-27 along with shadcn/ui
    //   itself — see component-list.md Part I). Whatever is added here next,
    //   this line stays.
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": [
    ".*/",
    "build/",
    "node_modules/",
    "static/",
    // Tailwind/Next.js prototype export kept at the repo root for reference.
    // It is not part of this Docusaurus build, and it imports 'next', which is
    // not a dependency here — so leaving it inside the program fails
    // `npm run typecheck` with TS2307 and turns the blocking CI gate red.
    "layout.tsx"
  ]
}
