{
  "name": "zebra-handheld-rfid-iotc",
  "version": "1.1.0",
  "private": true,
  "description": "Zebra Handheld RFID Reader | IoT Connector (IOTC) MQTT API Documentation. RFD40 / RFD90 Series.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/site/fix-opensearch.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "serve": "docusaurus serve",
    "pdf": "node scripts/site/generate-pdfs.mjs",
    "gen:reference": "python3 scripts/api/mqtt/generate_reference.py --generate all",
    "gen:check": "python3 scripts/api/mqtt/generate_reference.py --check",
    "gen:reconcile": "python3 scripts/api/mqtt/reconcile.py",
    "gen:reconcile:selftest": "python3 scripts/api/mqtt/reconcile.py --selftest",
    "gen:selftest": "python3 scripts/api/mqtt/generate_reference.py --selftest",
    "gen:contract-lint": "python3 scripts/api/mqtt/contract_lint.py",
    "gen:contract-lint:report": "python3 scripts/api/mqtt/contract_lint.py --report",
    "gen:contract-lint:selftest": "python3 scripts/api/mqtt/contract_lint.py --selftest",
    "gen:example-doctrine": "python3 scripts/api/mqtt/check_message_examples.py --contract api/mqtt/schema/iotc-rfd40-90-mqtt.asyncapi.json --check",
    "gen:example-doctrine:selftest": "python3 scripts/api/mqtt/check_message_examples.py --selftest",
    "lint:payload-parity": "python3 scripts/api/mqtt/payload_parity.py",
    "lint:payload-parity:report": "python3 scripts/api/mqtt/payload_parity.py --report",
    "lint:payload-parity:selftest": "python3 scripts/api/mqtt/payload_parity.py --selftest",
    "lint:variant-labels": "python3 scripts/api/mqtt/variant_labels.py",
    "lint:variant-labels:report": "python3 scripts/api/mqtt/variant_labels.py --report",
    "lint:variant-labels:selftest": "python3 scripts/api/mqtt/variant_labels.py --selftest",
    "lint:file-names": "python3 scripts/site/lint_file_names.py",
    "lint:file-names:census": "python3 scripts/site/lint_file_names.py --census",
    "lint:file-names:selftest": "python3 scripts/site/lint_file_names.py --selftest",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "lint:static-orphans": "node scripts/site/lint-static-orphans.mjs",
    "lint:fill-as-text": "node scripts/site/lint-fill-as-text.mjs",
    "lint:shape": "node scripts/site/lint-shape-language.mjs",
    "social-cards": "node scripts/site/generate-social-cards.mjs",
    "social-cards:check": "node scripts/site/generate-social-cards.mjs --check",
    "lint:schema-citations": "node scripts/site/lint-schema-citations.mjs",
    "lint:sidebar-sources": "node scripts/site/lint-sidebar-sources.mjs",
    "lint:section-rendering": "node scripts/site/lint-section-rendering.mjs",
    "lint:static-orphans:selftest": "node scripts/site/lint-static-orphans.mjs --selftest",
    "lint:schema-citations:selftest": "node scripts/site/lint-schema-citations.mjs --selftest",
    "lint:sidebar-sources:selftest": "node scripts/site/lint-sidebar-sources.mjs --selftest",
    "lint:section-rendering:selftest": "node scripts/site/lint-section-rendering.mjs --selftest",
    "verify:sidebar-names": "node scripts/site/verify-sidebar-name-guarantees.mjs",
    "verify:sidebar-names:anchors": "node scripts/site/verify-sidebar-name-guarantees.mjs --check-anchors",
    "icons": "node scripts/site/generate-icons.mjs",
    "icons:check": "node scripts/site/generate-icons.mjs --check",
    "icons:library": "node scripts/site/generate-icons.mjs --library",
    "icons:prune": "node scripts/site/generate-icons.mjs --prune",
    "write-translations": "docusaurus write-translations -l en"
  },
  "dependencies": {
    "@docsearch/docusaurus-adapter": "^5.0.4",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@scalar/api-reference": "^1.65.1",
    "@svgr/webpack": "^8.1.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "file-loader": "^6.2.0",
    "lucide-react": "^1.31.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-d2": "^0.2.3",
    "sass": "^1.69.0",
    "url-loader": "^4.1.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@docsearch/docusaurus-adapter": {
      "@docsearch/core": "$@docsearch/docusaurus-adapter",
      "@docsearch/modal": "$@docsearch/docusaurus-adapter",
      "@docsearch/react": "$@docsearch/docusaurus-adapter",
      "@docsearch/sidepanel": "$@docsearch/docusaurus-adapter"
    },
    "serialize-javascript": ">=7.0.5 <8",
    "uuid": ">=11.1.1 <12",
    "brace-expansion": "1.1.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "lucide-static": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22.0"
  }
}
